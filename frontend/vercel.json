{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/assets/cards/:match*",
      "has": [
        {
          "type": "header",
          "key": "sec-fetch-dest",
          "value": "document"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/assets/cards/:match*",
      "missing": [
        {
          "type": "header",
          "key": "referer"
        }
      ],
      "destination": "/",
      "permanent": false
    }
  ]
}
